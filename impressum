<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--g:#b8963e;--g2:#e8c96a;--g3:#7a5c1e;--bg:#060504;--bg2:#0d0b08;--txt:#f0e8d5;--muted:#6b5d46}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--txt);font-family:'Outfit',sans-serif;overflow-x:hidden;cursor:none;min-height:100vh}
@media(max-width:900px){body{cursor:auto}}

/* CURSOR */
#cur{position:fixed;width:8px;height:8px;background:var(--g);border-radius:50%;pointer-events:none;z-index:8888;transform:translate(-50%,-50%);mix-blend-mode:difference}
#cr{position:fixed;width:36px;height:36px;border:1px solid rgba(184,150,62,.5);border-radius:50%;pointer-events:none;z-index:8887;transform:translate(-50%,-50%);transition:width .3s,height .3s,border-color .3s}
@media(max-width:900px){#cur,#cr{display:none}}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:500;padding:1.4rem 3rem;display:flex;justify-content:space-between;align-items:center}
nav::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,5,4,.97),transparent);pointer-events:none}
.nav-logo{font-family:'Cinzel',serif;font-size:1.25rem;color:var(--g);letter-spacing:.15em;position:relative;z-index:1;text-decoration:none}
.nav-back{position:relative;z-index:1;font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);text-decoration:none;display:flex;align-items:center;gap:.5rem;transition:color .3s}
.nav-back:hover{color:var(--g)}
@media(max-width:900px){nav{padding:1rem 1.5rem}}

/* PARTICLES */
#pc{position:fixed;inset:0;z-index:0;pointer-events:none}

/* MAIN CONTENT */
main{position:relative;z-index:10;max-width:720px;margin:0 auto;padding:10rem 4rem 6rem}
@media(max-width:900px){main{padding:8rem 1.5rem 4rem}}

.se{font-size:.62rem;letter-spacing:.45em;text-transform:uppercase;color:var(--g);margin-bottom:1rem;display:flex;align-items:center;gap:1rem}
.se::before{content:'';width:30px;height:1px;background:var(--g)}
.page-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(3rem,8vw,6rem);line-height:.95;color:var(--txt);margin-bottom:3rem}

h3{font-family:'Cinzel',serif;font-size:1rem;color:var(--g);margin:2.5rem 0 .7rem;letter-spacing:.1em}
h3:first-of-type{margin-top:0}
p,li{font-size:.85rem;color:var(--muted);line-height:2}
ul{padding-left:1.2rem;margin-top:.4rem}
a{color:var(--g);text-decoration:none;transition:opacity .2s}
a:hover{opacity:.7;text-decoration:underline}

.placeholder{background:rgba(184,150,62,.06);border:1px dashed rgba(184,150,62,.3);padding:.2rem .7rem;font-size:.78rem;color:var(--g2);font-style:italic;display:inline-block}

.divider{width:100%;height:1px;background:linear-gradient(90deg,transparent,rgba(184,150,62,.2),transparent);margin:3rem 0}

/* FOOTER */
footer{position:relative;z-index:10;background:#030201;padding:2.5rem 4rem;display:flex;justify-content:space-between;align-items:center;border-top:1px solid rgba(184,150,62,.06);flex-wrap:wrap;gap:1rem}
.flogo{font-family:'Cinzel',serif;font-size:1.1rem;color:var(--g);letter-spacing:.2em}
.fctr{font-size:.6rem;letter-spacing:.15em;color:var(--muted);text-transform:uppercase;line-height:1.8;text-align:center}
.frgt{font-size:.6rem;color:var(--muted);text-align:right}
.frgt a{color:var(--muted);text-decoration:none;transition:color .3s}
.frgt a:hover{color:var(--g)}
@media(max-width:900px){footer{padding:2rem 1.5rem;justify-content:center;text-align:center}.frgt{text-align:center}}

/* FADE IN */
.fi{opacity:0;transform:translateY(20px);animation:fadeUp .7s ease forwards}
.fi:nth-child(2){animation-delay:.1s}
.fi:nth-child(3){animation-delay:.15s}
@keyframes fadeUp{to{opacity:1;transform:none}}
</style>
</head>
