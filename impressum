<script>
const cur=document.getElementById('cur'),cr=document.getElementById('cr')
let mx=0,my=0,rx=0,ry=0
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px'})
;(function a(){rx+=(mx-rx)*.1;ry+=(my-ry)*.1;cr.style.left=rx+'px';cr.style.top=ry+'px';requestAnimationFrame(a)})()

const pcanv=document.getElementById('pc'),ctx=pcanv.getContext('2d')
let PW,PH
function pr(){PW=pcanv.width=window.innerWidth;PH=pcanv.height=window.innerHeight}
pr();window.addEventListener('resize',pr)
const P=[];for(let i=0;i<80;i++)P.push({x:Math.random()*3000,y:Math.random()*2000,vx:(Math.random()-.5)*.3,vy:-Math.random()*.4-.1,r:Math.random()*1.2+.3,a:Math.random()*.3+.05})
;(function dp(){ctx.clearRect(0,0,PW,PH);P.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.y<-5){p.y=PH+5;p.x=Math.random()*PW}if(p.x<0||p.x>PW)p.vx*=-1;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle=`rgba(184,150,62,${p.a})`;ctx.fill()});requestAnimationFrame(dp)})()
</script>
